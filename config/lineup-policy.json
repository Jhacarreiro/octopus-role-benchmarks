{
  "schemaVersion": 16,
  "latestGenerationOnly": true,
  "poolPrecheck": {
    "minFamilies": 5,
    "floorStep": 0.005
  },
  "minFamilies": 4,
  "maxFamilies": 8,
  "maxSeatsPerFamily": 2,
  "allowRepeatedModel": true,
  "allowRepeatedBenchmarkIdentity": true,
  "codingConstraints": {
    "reviewerDifferentFromImplementer": true,
    "reviewerDifferentFromHeavy": true,
    "heavyDifferentFromImplementer": true,
    "heavyMinimumImplementerQualityDelta": 2
  },
  "modes": {
    "quality": {
      "label": "Quality",
      "description": "Highest role quality inside the Intelligence-qualified pool. Price does not affect selection.",
      "requestedIntelligenceFloor": 0.85,
      "objective": "maximize-role-quality",
      "minFamilies": 4
    },
    "balanced": {
      "label": "Balanced",
      "description": "Starts with 75% role quality and 25% affordability. Then each quality point lost requires at least 5% lower cost for that role, compared with the fixed initial selection. No limit on qualifying swaps; price and diversity rules remain enforced.",
      "requestedIntelligenceFloor": 0.8,
      "objective": "initial-balanced-score-then-score-price-exchange",
      "priceOutlierFilter": {
        "method": "mean-plus-population-standard-deviations",
        "standardDeviations": 2,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "percentileWeights": {
        "quality": 0.75,
        "affordability": 0.25
      },
      "minFamilies": 5,
      "priceRankFilter": {
        "method": "highest-distinct-cost-levels",
        "excludeHighestPriceLevels": 1,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "postSelectionOptimization": {
        "enabled": true,
        "objective": "minimize-plan-adjusted-cost",
        "exchangeRule": "price-saving-percent-per-quality-point",
        "savingPercentPerPoint": 5,
        "measuredReplacementsOnly": true,
        "maxIntelligenceExceptions": null,
        "maxSwaps": null,
        "maxSearchNodes": 1000000
      }
    },
    "budget": {
      "label": "Budget",
      "description": "Starts with 40% role quality and 60% affordability. Then each quality point lost requires at least 2% lower cost for that role, compared with the fixed initial selection. No limit on qualifying swaps; price and diversity rules remain enforced.",
      "requestedIntelligenceFloor": 0.75,
      "objective": "initial-role-budget-score-then-score-price-exchange",
      "priceOutlierFilter": {
        "method": "mean-plus-population-standard-deviations",
        "standardDeviations": 2,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "minFamilies": 5,
      "priceRankFilter": {
        "method": "highest-distinct-cost-levels",
        "excludeHighestPriceLevels": 2,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "postSelectionOptimization": {
        "enabled": true,
        "objective": "minimize-plan-adjusted-cost",
        "exchangeRule": "price-saving-percent-per-quality-point",
        "savingPercentPerPoint": 2,
        "measuredReplacementsOnly": true,
        "maxIntelligenceExceptions": null,
        "maxSwaps": null,
        "maxSearchNodes": 1000000
      }
    }
  },
  "swapEvaluation": {
    "scope": "regenerate-full-portfolio",
    "applyAutomatically": false,
    "note": "Lineups are generated from current benchmark data; weekly review compares regenerated portfolios rather than static single-seat picks."
  },
  "planEconomics": {
    "sourceUrl": "https://commandcode.ai/docs/plans/max",
    "referencePlan": "max10x",
    "monthlyPriceUsd": 100,
    "standardMonthlyUsageLimitUsd": 150,
    "premiumMonthlyUsageLimitUsd": 100,
    "max20Scale": 2,
    "note": "Max 10x and Max 20x have identical price-to-allowance ratios; portfolio ordering is invariant between them."
  },
  "premiumPlacement": {
    "rolePriority": [
      "security-reviewer",
      "code-reviewer",
      "architect",
      "strategist",
      "synthesizer",
      "researcher",
      "implementer",
      "implementer-heavy"
    ],
    "balancedMaxObjectiveLossPercent": 1,
    "tieBreakOnlyModes": [
      "quality",
      "budget"
    ],
    "description": "Prefer expensive models in planning/review and cheaper models in execution. Balanced may trade up to 1% of total Balanced objective for better placement; Quality and Budget use placement only as an exact-objective tie-break."
  }
}

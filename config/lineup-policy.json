{
  "schemaVersion": 19,
  "latestGenerationOnly": true,
  "poolPrecheck": {
    "minFamilies": 5,
    "floorStep": 0.005
  },
  "minFamilies": 4,
  "maxFamilies": 8,
  "maxSeatsPerFamily": 2,
  "allowRepeatedModel": true,
  "allowRepeatedBenchmarkIdentity": true,
  "codingConstraints": {
    "reviewerDifferentFromImplementer": true,
    "reviewerDifferentFromHeavy": true,
    "heavyDifferentFromImplementer": true,
    "heavyMinimumImplementerQualityDelta": 2,
    "reviewerMinimumReviewerQualityDelta": 2
  },
  "modes": {
    "quality": {
      "label": "Quality",
      "description": "Highest role quality inside the Intelligence-qualified pool. Price does not affect selection.",
      "requestedIntelligenceFloor": 0.85,
      "objective": "maximize-role-quality",
      "minFamilies": 4
    },
    "balanced": {
      "label": "Balanced",
      "description": "Starts with the highest role quality within the price and diversity rules, with no relative Intelligence cutoff. Each quality point lost then requires at least 15% lower cost for that role against the fixed initial selection. Known Intelligence, coding independence and the Heavy/Reviewer +2 rules remain required.",
      "requestedIntelligenceFloor": 0,
      "objective": "initial-role-quality-then-score-price-exchange",
      "priceOutlierFilter": {
        "method": "mean-plus-population-standard-deviations",
        "standardDeviations": 2,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "minFamilies": 5,
      "priceRankFilter": {
        "method": "highest-distinct-cost-levels",
        "excludeHighestPriceLevels": 1,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "postSelectionOptimization": {
        "enabled": true,
        "objective": "minimize-plan-adjusted-cost",
        "exchangeRule": "price-saving-percent-per-quality-point",
        "savingPercentPerPoint": 15,
        "measuredReplacementsOnly": true,
        "maxIntelligenceExceptions": null,
        "maxSwaps": null,
        "maxSearchNodes": 1000000
      },
      "initialSelection": "quality",
      "percentileWeights": {
        "quality": 0.75,
        "affordability": 0.25
      }
    },
    "budget": {
      "label": "Budget",
      "description": "Starts with the highest role quality within the price and diversity rules, with no relative Intelligence cutoff. Each quality point lost then requires at least 10% lower cost for that role against the fixed initial selection. Known Intelligence, coding independence and the Heavy/Reviewer +2 rules remain required.",
      "requestedIntelligenceFloor": 0,
      "objective": "initial-role-quality-then-score-price-exchange",
      "priceOutlierFilter": {
        "method": "mean-plus-population-standard-deviations",
        "standardDeviations": 2,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "minFamilies": 5,
      "priceRankFilter": {
        "method": "highest-distinct-cost-levels",
        "excludeHighestPriceLevels": 2,
        "costMetric": "planAdjustedCostPerTaskUsd"
      },
      "postSelectionOptimization": {
        "enabled": true,
        "objective": "minimize-plan-adjusted-cost",
        "exchangeRule": "price-saving-percent-per-quality-point",
        "savingPercentPerPoint": 10,
        "measuredReplacementsOnly": true,
        "maxIntelligenceExceptions": null,
        "maxSwaps": null,
        "maxSearchNodes": 1000000
      },
      "initialSelection": "quality"
    }
  },
  "swapEvaluation": {
    "scope": "regenerate-full-portfolio",
    "applyAutomatically": false,
    "note": "Lineups are generated from current benchmark data; weekly review compares regenerated portfolios rather than static single-seat picks."
  },
  "planEconomics": {
    "sourceUrl": "https://commandcode.ai/docs/plans/max",
    "referencePlan": "max10x",
    "monthlyPriceUsd": 100,
    "standardMonthlyUsageLimitUsd": 150,
    "premiumMonthlyUsageLimitUsd": 100,
    "max20Scale": 2,
    "note": "Max 10x and Max 20x have identical price-to-allowance ratios; portfolio ordering is invariant between them."
  },
  "premiumPlacement": {
    "rolePriority": [
      "security-reviewer",
      "code-reviewer",
      "architect",
      "strategist",
      "synthesizer",
      "researcher",
      "implementer",
      "implementer-heavy"
    ],
    "balancedMaxObjectiveLossPercent": 0,
    "tieBreakOnlyModes": [
      "quality",
      "budget"
    ],
    "description": "Placement breaks exact quality ties in initial Quality-first portfolios; it cannot sacrifice quality. Subsequent Balanced/Budget exchanges follow their explicit rates."
  }
}
